diff -u a/nvidia/nv-procfs.c b/nvidia/nv-procfs.c
--- a/nvidia/nv-procfs.c
+++ b/nvidia/nv-procfs.c
@@ -671,6 +671,141 @@
     return single_open(file, nv_procfs_show_suspend, NULL);
 }
 
+/*
+ * ZSS: /proc/driver/nvidia/zss_wake. Reads as the number of wake requests so
+ * far, followed by who is waiting; poll() reports it readable when that number
+ * has changed since this open file last read it. See nv_zss_request_wake()
+ * in nv.c.
+ */
+static int
+nv_procfs_open_zss_wake(
+    struct inode *inode,
+    struct file *file
+)
+{
+    file->private_data = (void *)(unsigned long)nv_zss_wake_count();
+    return 0;
+}
+
+static ssize_t
+nv_procfs_read_zss_wake(
+    struct file *file,
+    char __user *buffer,
+    size_t count,
+    loff_t *pos
+)
+{
+    unsigned int requests = nv_zss_wake_count();
+    char text[512];
+    int len = nv_zss_wake_text(text, sizeof(text));
+
+    file->private_data = (void *)(unsigned long)requests;
+    return simple_read_from_buffer(buffer, count, pos, text, len);
+}
+
+static __poll_t
+nv_procfs_poll_zss_wake(
+    struct file *file,
+    poll_table *wait
+)
+{
+    poll_wait(file, &nv_zss_wake_wq, wait);
+    if (nv_zss_wake_count() != (unsigned int)(unsigned long)file->private_data)
+        return EPOLLIN | EPOLLRDNORM | EPOLLPRI;
+    return 0;
+}
+
+/*
+ * ZSS: /proc/driver/nvidia/zss_hold. Write "freeze", "thaw" or "release"
+ * (see nv_zss_freeze() in nv.c); reads as "frozen" or "running".
+ */
+static int
+nv_procfs_show_zss_hold(
+    struct seq_file *m,
+    void *v
+)
+{
+    seq_printf(m, "%s\n", nv_zss_frozen() ? "frozen" : "running");
+    return 0;
+}
+
+static int
+nv_procfs_open_zss_hold(
+    struct inode *inode,
+    struct file *file
+)
+{
+    return single_open(file, nv_procfs_show_zss_hold, NULL);
+}
+
+static ssize_t
+nv_procfs_write_zss_hold(
+    struct file *file,
+    const char __user *buf,
+    size_t count,
+    loff_t *pos
+)
+{
+    char kbuf[sizeof("release\n")];
+    unsigned i;
+    int ret;
+
+    if (!NV_IS_SUSER())
+    {
+        return -EPERM;
+    }
+
+    if (count < strlen("thaw") || count > sizeof(kbuf))
+    {
+        return -EINVAL;
+    }
+
+    if (copy_from_user(kbuf, buf, count))
+    {
+        return -EFAULT;
+    }
+
+    count = min(count, sizeof(kbuf) - 1);
+    for (i = 0; i < count && isalpha(kbuf[i]); i++);
+    kbuf[i] = '\0';
+
+    if (strcasecmp(kbuf, "freeze") == 0)
+    {
+        ret = nv_zss_freeze();
+    }
+    else if (strcasecmp(kbuf, "thaw") == 0)
+    {
+        ret = nv_zss_thaw();
+    }
+    else if (strcasecmp(kbuf, "release") == 0)
+    {
+        ret = nv_zss_release();
+    }
+    else
+    {
+        return -EINVAL;
+    }
+
+    return (ret != 0) ? ret : count;
+}
+
+static nv_proc_ops_t nv_procfs_zss_hold_fops = {
+     NV_PROC_OPS_SET_OWNER()
+    .NV_PROC_OPS_OPEN    = nv_procfs_open_zss_hold,
+    .NV_PROC_OPS_READ    = seq_read,
+    .NV_PROC_OPS_WRITE   = nv_procfs_write_zss_hold,
+    .NV_PROC_OPS_LSEEK   = seq_lseek,
+    .NV_PROC_OPS_RELEASE = single_release
+};
+
+static const nv_proc_ops_t nv_procfs_zss_wake_fops = {
