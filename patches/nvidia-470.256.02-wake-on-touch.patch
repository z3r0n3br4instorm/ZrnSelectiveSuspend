+void nv_zss_wait_done(void);
+unsigned int nv_zss_wake_count(void);
+int nv_zss_wake_text(char *text, int size);
+extern wait_queue_head_t nv_zss_wake_wq;
+
+/*
+ * ZSS: instead of spinning until a resume that may never come, ask for one
+ * and sleep. The fast path, taken whenever the driver is running, is the
+ * same single trylock as before.
+ */
 static inline int nv_read_lock_system_pm_lock_interruptible(void)
 {
-    while (!down_read_trylock(&nv_system_pm_lock))
-    {
-        if (signal_pending(current))
-            return -EINTR;
-        cond_resched();
-    }
-    return 0;
+    int ret;
+
+    if (down_read_trylock(&nv_system_pm_lock))
+        return 0;
+    nv_zss_request_wake();
+    ret = down_read_interruptible(&nv_system_pm_lock) ? -EINTR : 0;
+    nv_zss_wait_done();
+    return ret;
+}
+
+static inline void nv_read_lock_system_pm_lock(void)
+{
+    if (down_read_trylock(&nv_system_pm_lock))
+        return;
+    nv_zss_request_wake();
+    down_read(&nv_system_pm_lock);
+    nv_zss_wait_done();
 }
 
