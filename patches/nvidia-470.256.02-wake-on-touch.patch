diff -u a/nvidia/nv.c b/nvidia/nv.c
--- a/nvidia/nv.c
+++ b/nvidia/nv.c
@@ -106,6 +106,103 @@
 
 struct rw_semaphore nv_system_pm_lock;
 
+/*
+ * ZSS wake-on-touch.
+ *
+ * While the driver is suspended through /proc/driver/nvidia/suspend, every
+ * caller waits on nv_system_pm_lock until someone writes "resume". Outside a
+ * real system sleep nobody will, unless told that a caller is waiting. Each
+ * caller that finds the lock held counts itself here and wakes anyone polling
+ * /proc/driver/nvidia/zss_wake; a daemon waiting there powers the GPU back on
+ * and resumes the driver. The same count is readable, for diagnostics, in
+ * /sys/module/nvidia/parameters/zss_wake_requests. Nothing changes while the
+ * driver is running.
+ *
+ * The file also lists who is waiting, so that the daemon can decide whose
+ * request is worth powering the GPU on for. A caller is listed from
+ * nv_zss_request_wake() until nv_zss_wait_done().
+ */
+#define NV_ZSS_MAX_WAITERS 32
+
+static unsigned int zss_wake_requests;
+module_param(zss_wake_requests, uint, 0444);
+DECLARE_WAIT_QUEUE_HEAD(nv_zss_wake_wq);
+
+static DEFINE_SPINLOCK(zss_waiters_lock);
+static unsigned int zss_waiting;
+static struct {
+    pid_t thread;
+    pid_t process;
+} zss_waiters[NV_ZSS_MAX_WAITERS];
+
+void nv_zss_request_wake(void)
+{
+    unsigned long flags;
+    int i;
+
+    spin_lock_irqsave(&zss_waiters_lock, flags);
+    zss_waiting++;
+    for (i = 0; i < NV_ZSS_MAX_WAITERS; i++)
+    {
+        if (zss_waiters[i].thread == 0)
+        {
+            zss_waiters[i].thread = current->pid;
+            zss_waiters[i].process = current->tgid;
+            break;
+        }
+    }
+    zss_wake_requests++;
+    spin_unlock_irqrestore(&zss_waiters_lock, flags);
+    wake_up_interruptible(&nv_zss_wake_wq);
+}
+EXPORT_SYMBOL(nv_zss_request_wake);
+
+void nv_zss_wait_done(void)
+{
+    unsigned long flags;
+    int i;
+
+    spin_lock_irqsave(&zss_waiters_lock, flags);
+    if (zss_waiting > 0)
+        zss_waiting--;
+    for (i = 0; i < NV_ZSS_MAX_WAITERS; i++)
+    {
+        if (zss_waiters[i].thread == current->pid)
+        {
+            zss_waiters[i].thread = 0;
+            break;
+        }
+    }
+    spin_unlock_irqrestore(&zss_waiters_lock, flags);
+}
+EXPORT_SYMBOL(nv_zss_wait_done);
+
+/*
+ * The contents of /proc/driver/nvidia/zss_wake: the request count, then
+ * "waiting N", then the process id of each listed waiter, one per line.
+ * N exceeds the number of lines when more callers wait than can be listed.
+ */
+int nv_zss_wake_text(char *text, int size)
+{
+    unsigned long flags;
+    int i, len;
+
+    spin_lock_irqsave(&zss_waiters_lock, flags);
+    len = scnprintf(text, size, "%u\nwaiting %u\n", zss_wake_requests, zss_waiting);
+    for (i = 0; i < NV_ZSS_MAX_WAITERS; i++)
+    {
+        if (zss_waiters[i].thread != 0)
+            len += scnprintf(text + len, size - len, "%d\n", zss_waiters[i].process);
+    }
+    spin_unlock_irqrestore(&zss_waiters_lock, flags);
+    return len;
+}
+
+unsigned int nv_zss_wake_count(void)
+{
+    return READ_ONCE(zss_wake_requests);
+}
+
