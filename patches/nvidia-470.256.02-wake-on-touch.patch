+/*
+ * ZSS freeze: the device has vanished without warning.
+ *
+ * A suspend closes the gate that every caller passes through and then saves
+ * the device's state. With the device gone there is nothing to save, and
+ * asking it is what makes the driver give up on it for good. Freezing does
+ * the first half only: the gate is closed, the periodic check and the bottom
+ * half are stopped, and each device is marked suspended, without one access
+ * to the hardware. When the device is back, powered and with its PCI state
+ * restored, nv_zss_thaw() runs the ordinary resume, which initialises a
+ * device from nothing, and opens the gate.
+ *
+ * nvidia-uvm is not told, as its suspend would talk to the device.
+ */
+static int zss_frozen;
+void (*nv_zss_modeset_gate)(int closed);
+EXPORT_SYMBOL(nv_zss_modeset_gate);
+
+int nv_zss_frozen(void)
+{
+    return READ_ONCE(zss_frozen);
+}
+
+/*
+ * These three are exported GPL-only on purpose: the kernel lets a module look
+ * a symbol up at run time (symbol_get) only if it is, and that is how the zss
+ * module reaches them without depending on this driver being loaded.
+ */
+int nv_zss_freeze(void)
+{
+    nv_linux_state_t *nvl;
+
+    down(&nv_system_power_state_lock);
+    if (zss_frozen || nv_system_power_state != NV_POWER_STATE_RUNNING)
+    {
+        up(&nv_system_power_state_lock);
+        return -EBUSY;
+    }
+
+    NV_WRITE_LOCK_SYSTEM_PM_LOCK();
+    if (nv_zss_modeset_gate != NULL)
+        nv_zss_modeset_gate(1);
+
+    LOCK_NV_LINUX_DEVICES();
+    for (nvl = nv_linux_devices; nvl != NULL; nvl = nvl->next)
+    {
+        nv_state_t *nv = NV_STATE_PTR(nvl);
+
+        down(&nvl->ldata_lock);
+        if ((((nv->flags & NV_FLAG_OPEN) != 0) ||
+             ((nv->flags & NV_FLAG_PERSISTENT_SW_STATE) != 0)) &&
+            ((nv->flags & NV_FLAG_SUSPENDED) == 0))
+        {
+            nv_stop_rc_timer(nv);
+            nv_kthread_q_stop(&nvl->bottom_half_q);
+            nv_disable_pat_support();
+            nv->flags |= NV_FLAG_SUSPENDED;
+        }
+        up(&nvl->ldata_lock);
+    }
+    UNLOCK_NV_LINUX_DEVICES();
+
+    nv_system_power_state = NV_POWER_STATE_IN_STANDBY;
+    WRITE_ONCE(zss_frozen, 1);
+    up(&nv_system_power_state_lock);
+
+    nv_printf(NV_DBG_ERRORS, "NVRM: ZSS: frozen; nothing was asked of the device\n");
+    return 0;
+}
+EXPORT_SYMBOL_GPL(nv_zss_freeze);
+
+static void zss_open_gate(void)
+{
+    if (nv_zss_modeset_gate != NULL)
+        nv_zss_modeset_gate(0);
+    NV_WRITE_UNLOCK_SYSTEM_PM_LOCK();
+    nv_system_power_state = NV_POWER_STATE_RUNNING;
+    WRITE_ONCE(zss_frozen, 0);
+}
+
+/* Resumes every frozen device and opens the gate. On failure the driver stays frozen. */
+int nv_zss_thaw(void)
+{
+    nv_linux_state_t *nvl;
+    NV_STATUS status = NV_OK;
+
+    down(&nv_system_power_state_lock);
+    if (!zss_frozen)
+    {
+        up(&nv_system_power_state_lock);
+        return -EINVAL;
+    }
+
+    LOCK_NV_LINUX_DEVICES();
+    for (nvl = nv_linux_devices; nvl != NULL && status == NV_OK; nvl = nvl->next)
+    {
+        status = nvidia_resume(nvl->dev, NV_PM_ACTION_RESUME);
+    }
+    UNLOCK_NV_LINUX_DEVICES();
+
+    if (status == NV_OK)
+        zss_open_gate();
+    up(&nv_system_power_state_lock);
+
+    nv_printf(NV_DBG_ERRORS, "NVRM: ZSS: thaw %s (0x%x)\n",
+              (status == NV_OK) ? "done" : "FAILED, still frozen", status);
+    return (status == NV_OK) ? 0 : -EIO;
+}
+EXPORT_SYMBOL_GPL(nv_zss_thaw);
+
+/*
+ * Opens the gate without resuming anything: the way out when a thaw cannot
+ * succeed. Callers then meet a device the driver has not initialised.
+ */
+int nv_zss_release(void)
+{
+    down(&nv_system_power_state_lock);
+    if (!zss_frozen)
+    {
+        up(&nv_system_power_state_lock);
+        return -EINVAL;
+    }
+    zss_open_gate();
+    up(&nv_system_power_state_lock);
+    nv_printf(NV_DBG_ERRORS, "NVRM: ZSS: gate opened without a resume\n");
+    return 0;
+}
+EXPORT_SYMBOL_GPL(nv_zss_release);
+
 NV_STATUS
 nv_set_system_power_state(
     nv_power_state_t power_state,
@@ -4323,6 +4549,13 @@
 
     down(&nv_system_power_state_lock);
 
+    /* ZSS: a frozen driver is brought back by nv_zss_thaw(), which knows nothing was saved. */
+    if (zss_frozen)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto done;
+    }
+
     if (nv_system_power_state == power_state)
     {
         status = NV_OK;
diff -u a/nvidia/nv-mmap.c b/nvidia/nv-mmap.c
