[Unit]
Description=ZrnSelectiveSuspend daemon (GPU power-off and application migration)
Documentation=file:///usr/local/share/doc/zss/README.md
After=zss-nvidia-check.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/zssd
# A device must never stay off without a daemon to wake it: callers would sleep for ever.
ExecStopPost=/usr/local/sbin/zssd --recover
# A daemon that stops answering is killed, and the line above then brings the device back.
WatchdogSec=20
NotifyAccess=main
Restart=on-failure
RestartSec=1
RuntimeDirectory=zss
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
